<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/statusCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/status_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp">

            <View
                android:id="@+id/statusRing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/status_ring"
                android:backgroundTint="@color/status_ok" />

            <ImageView
                android:id="@+id/statusIcon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_check"
                android:tint="@color/status_ok" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_status"
                android:backgroundTint="@color/status_ok"
                android:fontFamily="sans-serif-medium"
                android:paddingBottom="2dp"
                android:paddingEnd="10dp"
                android:paddingStart="10dp"
                android:paddingTop="2dp"
                android:text="@string/server_status"
                android:textColor="@color/on_status"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:autoSizeMaxTextSize="30sp"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/status_idle"
                android:textColor="@color/status_ok"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/detail_running"
                android:textColor="@color/text"
                android:textSize="@dimen/detail_text" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="84dp"
            android:layout_marginEnd="10dp"
            android:layout_marginStart="10dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_clock"
                    android:tint="@color/text_dim" />

                <TextView
                    style="@style/StatLabel"
                    android:text="@string/stat_uptime" />

                <TextView
                    android:id="@+id/tvUptime"
                    style="@style/StatValue" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_hash"
                    android:tint="@color/text_dim" />

                <TextView
                    style="@style/StatLabel"
                    android:text="@string/stat_pid" />

                <TextView
                    android:id="@+id/tvPid"
                    style="@style/StatValue" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_cube"
                    android:tint="@color/text_dim" />

                <TextView
                    style="@style/StatLabel"
                    android:text="@string/stat_version" />

                <TextView
                    android:id="@+id/tvVersion"
                    style="@style/StatValue" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Longer messages (errors, hints) get the full card width. -->
    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif"
        android:lineSpacingMultiplier="1.15"
        android:textColor="@color/text"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Web UI link and full manifest link; the text shrinks to fit the card width. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/panel_dark"
        android:orientation="vertical"
        android:padding="4dp">

        <LinearLayout
            android:id="@+id/btnUrl"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_focusable"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="12dp"
            android:paddingStart="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_globe"
                android:tint="#7FA8FF" />

            <TextView
                android:id="@+id/tvUrl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="15sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="http://127.0.0.1:7001"
                android:textColor="@color/text" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginEnd="14dp"
            android:layout_marginStart="14dp"
            android:background="@color/divider" />

        <LinearLayout
            android:id="@+id/btnManifest"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_focusable"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="12dp"
            android:paddingStart="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_star"
                android:tint="#FBBF24" />

            <TextView
                android:id="@+id/tvManifest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="15sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="http://127.0.0.1:7001/manifest.json"
                android:textColor="@color/text" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:id="@+id/lastDot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/circle"
            android:backgroundTint="@color/status_ok" />

        <TextView
            android:id="@+id/tvLastStarted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif"
            android:text="@string/last_started_none"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
