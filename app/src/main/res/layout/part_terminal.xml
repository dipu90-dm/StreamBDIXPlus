<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/terminal_card"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="10dp"
        android:paddingEnd="10dp"
        android:paddingStart="16dp"
        android:paddingTop="10dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/tile_dark"
            android:contentDescription="@null"
            android:padding="10dp"
            android:src="@drawable/ic_prompt"
            android:tint="@color/text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/term_title"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_green"
            android:backgroundTint="@color/status_ok"
            android:drawablePadding="7dp"
            android:drawableStart="@drawable/dot_small_green"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:paddingBottom="6dp"
            android:paddingEnd="14dp"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:text="@string/term_connected"
            android:textColor="@color/status_ok"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnCollapse"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="@string/cd_collapse"
            android:focusable="true"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_up"
            android:tint="@color/text" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/terminalBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="@dimen/log_height"
            android:background="@drawable/terminal_body"
            android:fillViewport="true"
            android:focusable="false"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tvPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.15"
                android:padding="14dp"
                android:textColor="@color/terminal_text"
                android:textSize="@dimen/preview_text" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <Button
                android:id="@+id/btnCopy"
                style="@style/PillButton"
                android:drawableStart="@drawable/ic_copy"
                android:text="@string/btn_copy" />

            <Button
                android:id="@+id/btnClear"
                style="@style/PillButton"
                android:layout_marginStart="10dp"
                android:drawableStart="@drawable/ic_trash"
                android:text="@string/btn_clear" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="sans-serif"
                android:text="@string/auto_scroll"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/swAutoScroll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:focusable="true"
                android:thumbTint="@color/switch_thumb"
                android:trackTint="@color/switch_track" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
