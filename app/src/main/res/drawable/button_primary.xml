<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/primary_focus_end"
                android:startColor="@color/primary_focus_start" />
            <stroke android:width="3dp" android:color="@color/focus_ring" />
            <corners android:radius="50dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/primary_pressed_end"
                android:startColor="@color/primary_pressed_start" />
            <corners android:radius="50dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/primary_end"
                android:startColor="@color/primary_start" />
            <stroke android:width="1.5dp" android:color="#66FFFFFF" />
            <corners android:radius="50dp" />
        </shape>
    </item>
</selector>
